# Copy to .env and fill in real values. .env is gitignored — never commit real credentials.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=marketpulse
DB_USER=marketpulse
DB_PASSWORD=changeme

# Path to the ticker watchlist (relative to repo root)
WATCHLIST_PATH=config/watchlist.yaml

# Max news headlines fetched per ticker per run
NEWS_PER_TICKER_LIMIT=15

# Minimum seconds between outbound requests to yfinance/RSS sources, shared
# across all workers. Lower = faster runs, higher risk of provider rate limits.
OUTBOUND_MIN_INTERVAL_SECONDS=0.25

# Concurrent workers for price and news fetching
PRICE_MAX_WORKERS=8
NEWS_MAX_WORKERS=8

# HuggingFace model id used for sentiment scoring
FINBERT_MODEL_NAME=ProsusAI/finbert
